<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Africa Centre for Climate Change and Environmental Sustainability</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --leaf:#4C9A2A; --deep:#12452E; --sky:#1F7FC4; --soil:#7A4B2A; --sun:#F2B632; --paper:#F7FAF4; --ink:#16231B; --card:#FFFFFF; --muted:#52645A;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--paper:#0F1B14;--ink:#EAF3E6;--card:#17271E;--muted:#A5B8AB;--deep:#CFE8BF}}
:root[data-theme="dark"]{--paper:#0F1B14;--ink:#EAF3E6;--card:#17271E;--muted:#A5B8AB;--deep:#CFE8BF}
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth;scroll-padding-top:70px}
body{margin:0;background:var(--paper);color:var(--ink);font-family:Figtree,system-ui,sans-serif;line-height:1.6;font-size:1.05rem}
h1,h2,h3{font-family:'Bricolage Grotesque',Figtree,sans-serif;line-height:1.1;margin:0 0 .6em;color:var(--deep)}
h1{font-size:clamp(2.4rem,7vw,4.6rem);font-weight:800;letter-spacing:-.02em}
h2{font-size:clamp(1.8rem,4.5vw,2.7rem);font-weight:700}
h3{font-size:1.25rem;font-weight:700}
p{margin:0 0 1em;max-width:62ch}
a{color:var(--sky)}
:focus-visible{outline:3px solid var(--sun);outline-offset:3px}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
section{padding:72px 0}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;background:var(--paper);border-bottom:1px solid color-mix(in srgb,var(--ink) 12%,transparent)}
nav{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 20px;max-width:1080px;margin:0 auto}
.brand{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;color:var(--deep);text-decoration:none;font-size:1.2rem}
.links{display:flex;gap:18px;flex-wrap:wrap}
.links a{color:var(--ink);text-decoration:none;font-weight:500;font-size:.95rem}
.links a:hover{color:var(--leaf)}
.logo{height:46px;width:auto;display:block;border-radius:8px;background:#fff}
.herologo{height:120px;width:auto;border-radius:16px;background:#fff;margin-bottom:20px;display:block}
.btn{display:inline-block;background:var(--leaf);color:#fff;padding:13px 24px;border-radius:999px;font-weight:600;text-decoration:none;border:0}
.btn.alt{background:transparent;color:var(--deep);box-shadow:inset 0 0 0 2px var(--deep)}
.hero{padding:64px 0 80px;background:linear-gradient(180deg,color-mix(in srgb,var(--leaf) 14%,var(--paper)),var(--paper))}
.hero .wrap{display:grid;gap:40px;grid-template-columns:1.3fr 1fr;align-items:center}
.hero p.lead{font-size:1.25rem;color:var(--muted)}
.cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}
.counter{background:var(--deep);color:#EAF3E6;border-radius:28px;padding:32px;text-align:center}
:root[data-theme="dark"] .counter,:root:not([data-theme="light"]) .counter{background:#1D3B2A}
.counter .n{font-family:'Bricolage Grotesque',sans-serif;font-size:4.5rem;font-weight:800;color:var(--sun);line-height:1}
.counter p{margin:8px auto 0}
.bar{height:12px;background:rgba(255,255,255,.18);border-radius:99px;margin:18px 0 6px;overflow:hidden}
.bar i{display:block;height:100%;width:6.7%;background:var(--sun);border-radius:99px}
.small{font-size:.9rem;opacity:.85}
.grid{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.card{background:var(--card);border-radius:18px;padding:24px;border-left:6px solid var(--leaf)}
.card:nth-child(3n+2){border-color:var(--sky)}
.card:nth-child(3n){border-color:var(--soil)}
.card p{color:var(--muted);margin:0}
.stats{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));margin-top:28px}
.stat{padding:8px 0 8px 18px;border-left:4px solid var(--sun)}
.stat b{display:block;font-family:'Bricolage Grotesque',sans-serif;font-size:2.4rem;color:var(--deep)}
.alt-bg{background:color-mix(in srgb,var(--sky) 8%,var(--paper))}
.two{display:grid;gap:36px;grid-template-columns:1fr 1fr}
.tags{display:flex;flex-wrap:wrap;gap:10px;padding:0;list-style:none;margin:0}
.tags li{background:var(--card);padding:9px 16px;border-radius:999px;font-weight:500;font-size:.95rem}
ul.plain{padding-left:1.1em;margin:0 0 1em}
ul.plain li{margin-bottom:.5em}
details{background:var(--card);border-radius:14px;padding:16px 20px;margin-bottom:10px}
summary{cursor:pointer;font-weight:600;color:var(--deep)}
details p{margin:10px 0 0;color:var(--muted)}
form{display:grid;gap:12px}
label{font-weight:600;font-size:.95rem}
input,textarea,select{width:100%;padding:12px 14px;border-radius:12px;border:1.5px solid color-mix(in srgb,var(--ink) 25%,transparent);background:var(--card);color:var(--ink);font:inherit}
textarea{min-height:110px;resize:vertical}
footer{background:var(--deep);color:#EAF3E6;padding:40px 0}
:root[data-theme="dark"] footer,:root:not([data-theme="light"]) footer{background:#0A130E}
footer a{color:var(--sun)}
@media(max-width:760px){.hero .wrap,.two{grid-template-columns:1fr}section{padding:52px 0}.links{display:none}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
